[Unit]
Description=Doviz Borc ve Alacak Takip Servisi
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/doviz-takip
ExecStart=/usr/bin/python3 src/main.py
Restart=always
RestartSec=5s
Environment=PYTHONUNBUFFERED=1
Environment=PORT=8765

# Güvenlik Kısıtlamaları
PrivateTmp=true
ProtectSystem=full
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target

