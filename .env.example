# Supabase & PostgreSQL Veritabanı Yapılandırması
# Vercel Environment Variables bölümüne de bu değişkenleri ekleyiniz.

# Supabase Transaction Pooler URI (Vercel Serverless için Port 6543 önerilir):
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase API Bilgileri (İsteğe bağlı REST entegrasyonları için)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Uygulama Ayarları
PORT=8765
ENVIRONMENT=production

